# Server-only. Copy to .env.local; never commit real credentials.
AI_API_KEY=
# Paste your Singapore workspace's OpenAI-compatible URL from Model Studio.
# Example: https://YOUR_WORKSPACE_ID.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
# Choose an available Qwen text model with active free quota. No model is hard-coded.
AI_MODEL=
# First enable "Free Quota Only" for that model in Alibaba's console, then set true.
# This acknowledgement is a local gate, not a remote billing control.
AI_FREE_QUOTA_ONLY_CONFIRMED=false
# json_schema for a model with verified schema support; json_object for broader Qwen support.
# json_only omits response_format for other compatible endpoints. One call; no repair/retry.
AI_OUTPUT_MODE=json_object
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2400
# Optional Qwen extension. false disables thinking for structured-output compatibility.
# Leave blank for providers that do not accept enable_thinking.
AI_ENABLE_THINKING=false
APP_URL=http://127.0.0.1:3000
DATABASE_URL=postgresql://fennlo:fennlo-local-only@127.0.0.1:55435/fennlo_prompt
# Only set behind a proxy that replaces this header and blocks direct access.
TRUSTED_CLIENT_IP_HEADER=
